# =============================================================================
# PropLedger — Environment Variables Configuration Template
# Copy this file to .env or use these variables in your system environment.
# =============================================================================

# --- Database Persistence (PostgreSQL 16) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propledger
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=10

# --- Backend Application (Spring Boot 3.3 / Java 21) ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Secret: Minimum 256-bit cryptographically secure string (HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Application (React 19 / Vite) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_TITLE=PropLedger
VITE_APP_VERSION=1.0.0
